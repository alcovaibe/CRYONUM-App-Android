<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- policy_prefs.xml intentionally remains in cloud backup so a reinstall
             can restore the user's acceptance of the same policy version. -->
        <!-- Исключаем историю и настройки из облака -->
        <exclude domain="sharedpref" path="history_prefs.xml"/>
        <exclude domain="sharedpref" path="theme_prefs.xml"/>
        <exclude domain="sharedpref" path="calc_prefs_v1.xml"/>
        <exclude domain="sharedpref" path="secure_settings.xml"/>
        <exclude domain="file" path="datastore/security_settings.preferences_pb"/>
        <exclude domain="file" path="cryonum_content/"/>
        <exclude domain="file" path="icy_content/"/>
        <exclude domain="file" path="datastore/content_download.preferences_pb"/>
        <exclude domain="file" path="datastore/policy_update.preferences_pb"/>
    </cloud-backup>

    <device-transfer>
        <!-- Require policy acceptance again after a device-to-device transfer. -->
        <exclude domain="sharedpref" path="policy_prefs.xml"/>
        <!-- Исключаем историю и настройки при прямом переносе -->
        <exclude domain="sharedpref" path="history_prefs.xml"/>
        <exclude domain="sharedpref" path="theme_prefs.xml"/>
        <exclude domain="sharedpref" path="calc_prefs_v1.xml"/>
        <exclude domain="sharedpref" path="secure_settings.xml"/>
        <exclude domain="file" path="datastore/security_settings.preferences_pb"/>
        <exclude domain="file" path="cryonum_content/"/>
        <exclude domain="file" path="icy_content/"/>
        <exclude domain="file" path="datastore/content_download.preferences_pb"/>
        <exclude domain="file" path="datastore/policy_update.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
