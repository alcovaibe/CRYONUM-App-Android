<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calculatorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical"
    tools:context=".activity.ActivityCalculator">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back"
                app:tint="?android:textColorPrimary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnSwitchMode"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_expand"
                android:contentDescription="@string/expand"
                app:tint="?android:textColorPrimary" />
        </LinearLayout>

        <EditText
            android:id="@+id/inputDisplay"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:gravity="end|center_vertical"
            android:paddingHorizontal="16dp"
            android:textSize="28sp"
            android:textColor="?android:textColorPrimary"
            android:background="@android:color/transparent"
            android:inputType="textNoSuggestions|textVisiblePassword"
            android:maxLines="2"
            android:focusable="true"
            android:cursorVisible="true"
            android:hint="@string/zero"
            android:importantForAutofill="no"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/resultDisplay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="28sp"
            android:textColor="?android:textColorPrimary"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/inputDisplay"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <GridLayout
            android:id="@+id/keyboardContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:rowCount="5"
            android:columnCount="3"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/resultDisplay"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Твои кнопки -->
            <Button android:id="@+id/btnC" android:text="@string/Clean" />
            <Button android:id="@+id/btnPercent" android:text="@string/symbol_percent" />
            <Button android:id="@+id/btnPower2" android:text="@string/symbol_power2" />
            <Button android:id="@+id/btn9" android:text="@string/nine" />
            <Button android:id="@+id/btn8" android:text="@string/eight" />
            <Button android:id="@+id/btn7" android:text="@string/seven" />
            <Button android:id="@+id/btn6" android:text="@string/six" />
            <Button android:id="@+id/btn5" android:text="@string/five" />
            <Button android:id="@+id/btn4" android:text="@string/four" />
            <Button android:id="@+id/btn3" android:text="@string/three" />
            <Button android:id="@+id/btn2" android:text="@string/two" />
            <Button android:id="@+id/btn1" android:text="@string/one" />
            <Button android:id="@+id/btnParenLeft" android:text="@string/symbol_open_bracket" />
            <Button android:id="@+id/btn0" android:text="@string/zero" />
            <Button android:id="@+id/btnParenRight" android:text="@string/symbol_close_bracket" />
            <Button android:id="@+id/btnPlus" android:text="@string/plas" />
            <Button android:id="@+id/btnMinus" android:text="@string/minus" />
            <Button android:id="@+id/btnDivide" android:text="@string/symbol_division" />
            <Button android:id="@+id/btnMultiply" android:text="@string/symbol_multiplication" />
            <Button android:id="@+id/btnMod" android:text="@string/module" />
            <Button android:id="@+id/btnEquals" android:text="@string/symbol_equals" />
        </GridLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
