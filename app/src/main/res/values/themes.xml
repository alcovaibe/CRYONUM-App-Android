<resources>

    <!-- Базовая тема -->
    <style name="Base.Theme.IcyMath" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Прозрачные системные панели (edge-to-edge) -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>

    <!-- Основная тема приложения -->
    <style name="Theme.IcyMath" parent="Base.Theme.IcyMath" />

    <!-- Тема для Splash Screen (Core SplashScreen API) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.IcyMath</item>
    </style>

    <!-- Светлая тема -->
    <style name="Theme.IcyMath.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="isLightTheme">true</item>
    </style>

    <!-- AMOLED Тема -->
    <style name="Theme.IcyMath.Amoled" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="isLightTheme">false</item>
        <item name="colorControlNormal">#FFFFFF</item>
    </style>

    <!-- Sandy Тема -->
    <style name="Theme.IcyMath.SandyBrown" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">#F4A460</item>
        <item name="android:statusBarColor">#F4A460</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="isLightTheme">true</item>
    </style>

    <!-- Системная тема -->
    <style name="Theme.IcyMath.System" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="isLightTheme">true</item>
    </style>
</resources>
